# Configurações de Produção - Sistema UTMify Tracking
# Copie este arquivo para .env e configure as variáveis restantes

# Configurações do Servidor
PORT=3001
NODE_ENV=production

# UTMify API
# ⚠️ IMPORTANTE: Configure seu token da UTMify aqui
UTMIFY_API_TOKEN=seu_token_da_utmify_aqui

# PushinPay - Credencial fornecida
PUSHINPAY_WEBHOOK_SECRET=6EPVqN7rtImQQOHcH1AAm0Txy6bq1stHWKlB

# Configurações de Segurança
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# URLs do Site
SITE_DOMAIN=stellabeghini.com
SITE_URL=https://stellabeghini.com

# UTMify Pixel ID (já configurado)
UTMIFY_PIXEL_ID=68c82ef8a21cee3362d76eee
